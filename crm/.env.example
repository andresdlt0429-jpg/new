# Copy this file to .env and fill in your own values.

# Port the CRM server listens on
PORT=3000

# Base URL where this app is reachable (used to build the Google OAuth redirect URI)
# For local dev, keep the default. If you deploy this, change it to your public URL.
BASE_URL=http://localhost:3000

# Google Cloud OAuth client credentials.
# Create these at https://console.cloud.google.com/apis/credentials
# 1. Create/select a project
# 2. Enable the "Google Calendar API"
# 3. Configure the OAuth consent screen (External is fine, add yourself as a test user)
# 4. Create an "OAuth client ID" of type "Web application"
# 5. Add this Authorized redirect URI: http://localhost:3000/auth/google/callback
#    (or {BASE_URL}/auth/google/callback if you changed BASE_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret used to sign the login cookie (any random string)
SESSION_SECRET=change-me-to-a-random-string
