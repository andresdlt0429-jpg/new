.env
__pycache__/
# Footage and renders stay local (large, regenerable). Folders kept via .gitkeep.
raw/*
proxy/*
work/*
# ...except transcript fixes (what was misheard, the evidence, who confirmed it)
!work/*/
work/*/*
!work/*/fixes.json
out/*
!*/.gitkeep
# Phase proof reports (numbers) are committed; stills stay local (test fixtures).
!out/phase*-proof/
out/phase*-proof/*.png
# Model weights are downloaded by the engines on first run.
engines/models/
engines/machine_limits.json
# Render QA reports (numbers only, no footage) are committed
!out/*/
out/*/*
!out/*/*_qa.json
# Generated graphics (rebuilt by every render)
cards/*/
# QA gate verdicts, intake report and hook-matrix manifests (text only)
!out/*/*_gate.json
!out/*/*_gate.md
!out/intake/intake.md
!out/intake/intake.json
!out/*/matrix/
out/*/matrix/*
!out/*/matrix/manifest.json
!out/*/matrix/manifest.csv
# Phase proof reports (numbers) after the out/*/* rule above
!out/phase*-proof/*.json
