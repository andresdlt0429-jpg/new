# Copy this file to .env and fill it in. .env never gets uploaded to GitHub.
# Never paste these into a chat, email, or text.

# From twilio.com/console (the "Account Info" box)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# The phone number you bought in Twilio, with +1
TWILIO_FROM_NUMBER=+15555550000

# A long random password that has to be in the webhook link.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_TOKEN=
